# Sherlock.ai - Environment Configuration Template
# Copy this file to .env and fill in your values

# ==================== BACKEND CONFIGURATION ====================

# Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development  # development, staging, production

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# File Upload Limits (in MB)
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100

# Allowed File Types
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/jpg,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/avi,video/mov,video/webm

# ==================== ML CONFIGURATION ====================

# Model Paths (relative to backend/)
MODEL_PATH=../ml/image_detector/saved_models/image_detector.pth
CLASS_MAP_PATH=../ml/image_detector/saved_models/class_map.json
MAHALANOBIS_PATH=../ml/image_detector/saved_models/mahalanobis.json

# Inference Settings
DEVICE=cpu  # cpu or cuda
TEMPERATURE=2.0
OOD_THRESHOLD=200.0

# Video Processing
VIDEO_FRAME_SKIP_RATIO=1  # Process every Nth frame (based on FPS)
VIDEO_SMOOTHING_WINDOW=5  # Temporal smoothing window
VIDEO_PHASE9_WINDOW=5     # Phase-9 temporal trust window

# ==================== LOGGING ====================

LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/sherlock.log
LOG_FORMAT=json  # json or text

# ==================== SECURITY ====================

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60  # seconds

# API Keys (if needed for production)
# API_KEY=your-secret-api-key

# ==================== STORAGE ====================

# Upload directories (relative to backend/)
UPLOAD_DIR=uploads
UNKNOWN_DIR=unknown_images
HEATMAP_DIR=heatmaps

# Cleanup Settings
AUTO_CLEANUP=true
CLEANUP_AFTER_HOURS=24

# ==================== FRONTEND CONFIGURATION ====================
# (For frontend/.env)

# API URL
VITE_API_URL=http://127.0.0.1:8000

# Feature Flags
VITE_ENABLE_VIDEO_DETECTION=true
VITE_ENABLE_ANALYTICS=false

# UI Settings
VITE_MAX_FILE_SIZE_MB=100
VITE_SUPPORTED_IMAGE_FORMATS=.jpg,.jpeg,.png,.webp
VITE_SUPPORTED_VIDEO_FORMATS=.mp4,.avi,.mov,.webm
